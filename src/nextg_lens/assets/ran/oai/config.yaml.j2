{# nextg-lens edits of the upstream OAI configuration, applied as text (a YAML round trip would rewrite values such #}
{# as mcc 001 or gNB_ID 0x1); the upstream rendering is included unchanged when none applies. #}
{# - CSI logger: SRS channel estimates need periodic SRS (and CSI-RS), which the upstream template does not expose. #}
{# - rfsimulator given as a mapping (advanced_config.rfsimulator is a dict in the orchestrator model): OAI 2026.w42 #}
{#   crashes (segmentation fault) when it opens the RF device with that form; it is rewritten as a one-element list. #}
{# - RFSIM_ANTENNAS "2" (nextg_lens.csi.set_rfsim_channel "2x2+awgn"): 2x2 MIMO as the 5g_ansible rfsim gNB/DU #}
{#   (nb_tx/nb_rx 2, pusch_AntennaPorts 2, maxMIMO_layers 2, pdsch_AntennaPorts N1 2 / N2 1 / XP 1), not exposed upstream. #}
{% set csi_env = component.extra_env_vars or {} %}
{% set csi = csi_env.get('CSI_LOGGING_ENABLED') | string == '1' %}
{% set rfsim_mapping = component.advanced_config is mapping and component.advanced_config.get('rfsimulator') is mapping %}
{% set mimo = csi_env.get('RFSIM_ANTENNAS') | string == '2' %}
{% if csi or rfsim_mapping or mimo %}
{% set upstream_config %}{% include 'ran/oai/oai-' ~ component.type ~ '/config.yaml.j2' %}{% endset %}
{% set ns = namespace(lines=[], block=false, first=false) %}
{% for line in upstream_config.split('\n') %}
{% if rfsim_mapping and line == 'rfsimulator:' %}
{% set ns.block = true %}
{% set ns.first = true %}
{% set ns.lines = ns.lines + [line] %}
{% elif ns.block and line.startswith('  ') %}
{% set ns.lines = ns.lines + [('  - ' ~ line[2:]) if ns.first else ('  ' ~ line)] %}
{% set ns.first = false %}
{% else %}
{% set ns.block = false %}
{% set ns.lines = ns.lines + [line] %}
{% endif %}
{% endfor %}
{% set config = ns.lines | join('\n') %}
{% if mimo %}
{% if config is not search('(?m)^    nb_tx: \d+$') or config is not search('(?m)^    nb_rx: \d+$') or config is search('(?m)^    nb_tx: \d+$[\s\S]*^    nb_tx: \d+$') or config is not search('(?m)^    min_rxtxtime: ') or config is search('(?m)^ +(pusch_AntennaPorts|maxMIMO_layers|pdsch_AntennaPorts_[A-Z0-9]+):') %}
{# Undefined variable on purpose: fail the prepare step instead of rendering a 1x1 configuration. #}
{{ rfsim_2x2_injection_failed_ru_antennas_not_found_once_or_antenna_ports_already_set }}
{% endif %}
{% set config = config | regex_replace('^    nb_tx: \d+$', '    nb_tx: 2', multiline=True) | regex_replace('^    nb_rx: \d+$', '    nb_rx: 2', multiline=True) %}
{% set config = config | regex_replace('^(    min_rxtxtime: [^\n]*)$', '\\1\n    pdsch_AntennaPorts_N1: 2\n    pdsch_AntennaPorts_N2: 1\n    pdsch_AntennaPorts_XP: 1\n    pusch_AntennaPorts: 2\n    maxMIMO_layers: 2', multiline=True) %}
{% endif %}
{% if csi %}
{# Text insertion after the single gNBs[0] min_rxtxtime line. #}
{% if config is search('(?m)^ +do_(SRS|CSIRS):') or config is not search('(?m)^    min_rxtxtime: ') %}
{# Undefined variable on purpose: fail the prepare step instead of rendering a config without SRS. #}
{{ csi_config_injection_failed_do_SRS_already_set_or_min_rxtxtime_not_found }}
{% endif %}
{% set config = config | regex_replace('^(    min_rxtxtime: [^\n]*)$', '\\1\n    do_SRS: periodic\n    do_CSIRS: 1', multiline=True) %}
{% endif %}
{{ config }}{% else %}
{% include 'ran/oai/oai-' ~ component.type ~ '/config.yaml.j2' %}
{% endif %}
