{% from '_component.yaml.j2' import settings with context %}
{% set roles = targets | map(attribute='role') | list %}
{% set session_context = 'amf' in roles and 'smf' in roles %}
{{ settings() }}
controller:
  watchNamespaces: {{ packet_namespaces | tojson }}
  probeMode: {{ ('both' if packet_targets | length == 2 else (packet_targets | first | default('both'))) | tojson }}
{% for role, target in packet_targets.items() %}
  {{ role }}Interface: {{ target.interface | tojson }}
  {{ role }}LatencyMode: {{ target.latency_mode | tojson }}
{% endfor %}
images:
  probe: {{ monitoring.images.probe | tojson }}
throughput:
  enabled: {{ monitoring.throughput | tojson }}
  probeImage: {{ monitoring.images.throughput | tojson }}
latency:
  enabled: {{ monitoring.latency | tojson }}
targets: {{ targets | tojson }}
operationTimeoutSeconds: {{ monitoring.operation_timeout_seconds }}
probeControllerImage: {{ monitoring.probe_controller_image | tojson }}
probeControlTargets: {{ ({} if monitoring.multi_anchor else packet_targets) | tojson }}
extendedProbeStates: {{ probe_states | tojson }}
probeApiTlsSecret: {{ monitoring.probe_api_tls_secret | tojson }}
probeApiTokenSecret: {{ monitoring.probe_api_token_secret | tojson }}
probeControl:
{% for key, value in monitoring.one_way.model_dump(mode="json").items() %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
{% if monitoring.one_way.image and monitoring.separate_one_way_targets %}
  one_way_targets: {{ packet_anchors | tojson }}
{% endif %}
rttRequest:
  enabled: {{ monitoring.latency | tojson }}
  allowed: {{ (monitoring.probe_controller_image is not none and session_context and (packet_anchors | length > 0)) | tojson }}
  image: {{ monitoring.images.probe | tojson }}
  imsis: {{ monitoring.rtt_imsis | tojson }}
  slices: {{ monitoring.rtt_slices | tojson }}
{% if monitoring.multi_anchor and monitoring.probe_controller_image %}
  targets: {{ packet_anchors | tojson }}
{% endif %}
throughputRequest:
  enabled: {{ monitoring.throughput | tojson }}
  allowed: {{ (monitoring.probe_controller_image is not none and session_context and (throughput_targets | length > 0) and monitoring.external_throughput_image is not none) | tojson }}
  image: {{ monitoring.external_throughput_image | tojson }}
{% if monitoring.multi_anchor and monitoring.probe_controller_image %}
  targets: {{ throughput_targets | tojson }}
{% endif %}
pathRequest:
  enabled: {{ monitoring.observability.user_plane_paths | tojson }}
  allowed: {{ ((packet_anchors | length > 0) and monitoring.external_path_image is not none) | tojson }}
  image: {{ monitoring.external_path_image | tojson }}
  port: {{ monitoring.observability.path_port }}
  interval: {{ monitoring.observability.path_interval_seconds }}
{% if monitoring.multi_anchor and monitoring.probe_controller_image %}
  targets: {{ packet_anchors | tojson }}
{% endif %}
