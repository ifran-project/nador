{% from '_component.yaml.j2' import settings with context %}
{% set monitoring_selector = node_selector if node_selector is not none else {'monitoring.blueprint/node': monitoring.namespace} %}
prometheusOperator:
  nodeSelector: {{ monitoring_selector | tojson }}
  tolerations: {{ component.tolerations | tojson }}
  admissionWebhooks:
    patch:
      nodeSelector: {{ monitoring_selector | tojson }}
      tolerations: {{ component.tolerations | tojson }}
kube-state-metrics:
  nodeSelector: {{ monitoring_selector | tojson }}
  tolerations: {{ component.tolerations | tojson }}
prometheus:
  service:
    nodePort: {{ monitoring.prometheus_node_port }}
  serviceMonitor:
    interval: {{ monitoring.prometheus_scrape_interval | tojson }}
  prometheusSpec:
{{ settings(split_registry=true) | indent(4, true) }}
    scrapeInterval: {{ monitoring.prometheus_scrape_interval | tojson }}
    evaluationInterval: {{ monitoring.prometheus_scrape_interval | tojson }}
    retention: {{ monitoring.prometheus_retention_period | tojson }}
    additionalScrapeConfigs:
      - job_name: kubernetes-annotated-services
        kubernetes_sd_configs:
        - namespaces:
            names: {{ target_namespaces | tojson }}
          role: service
        relabel_configs:
        - action: drop
          regex: endpoints
          source_labels: [__meta_kubernetes_service_annotation_monitoring_blueprint_scrape_mode]
        - action: keep
          regex: 'true'
          source_labels:
          - __meta_kubernetes_service_annotation_prometheus_io_scrape
        - action: replace
          regex: (.+)
          source_labels:
          - __meta_kubernetes_service_annotation_prometheus_io_path
          target_label: __metrics_path__
        - action: replace
          regex: ([^:]+)(?::\d+)?;(\d+)
          replacement: $1:$2
          source_labels:
          - __address__
          - __meta_kubernetes_service_annotation_prometheus_io_port
          target_label: __address__
        - action: labelmap
          regex: __meta_kubernetes_service_label_(.+)
        - action: replace
          source_labels:
          - __meta_kubernetes_namespace
          target_label: namespace
        - action: replace
          source_labels:
          - __meta_kubernetes_service_name
          target_label: service
        scrape_interval: '{{ monitoring.prometheus_scrape_interval }}'
      - job_name: observability-endpoints
        kubernetes_sd_configs:
        - namespaces:
            names: {{ target_namespaces | tojson }}
          role: endpoints
        relabel_configs:
        - action: keep
          regex: endpoints
          source_labels: [__meta_kubernetes_service_annotation_monitoring_blueprint_scrape_mode]
        - action: keep
          regex: observability
          source_labels: [__meta_kubernetes_endpoint_port_name]
        - source_labels: [__meta_kubernetes_namespace]
          target_label: namespace
        - source_labels: [__meta_kubernetes_pod_name]
          target_label: pod
        - source_labels: [__meta_kubernetes_pod_node_name]
          target_label: node
        - source_labels: [__meta_kubernetes_service_name]
          target_label: service
        scrape_interval: '{{ monitoring.prometheus_scrape_interval }}'
      - job_name: latency-probes
        kubernetes_sd_configs:
        - namespaces:
            names: {{ target_namespaces | tojson }}
          role: pod
        metrics_path: /latency
        relabel_configs:
        - action: keep
          regex: '{{ monitoring.namespace }}'
          source_labels:
          - __meta_kubernetes_pod_annotation_monitoring_blueprint_latency_owner
        - regex: (.+);([0-9]+)
          replacement: $1:$2
          source_labels:
          - __meta_kubernetes_pod_ip
          - __meta_kubernetes_pod_annotation_monitoring_blueprint_latency_port
          target_label: __address__
        - source_labels:
          - __meta_kubernetes_namespace
          target_label: namespace
        - source_labels:
          - __meta_kubernetes_pod_name
          target_label: pod
        scrape_interval: '{{ monitoring.prometheus_scrape_interval }}'
{% if monitoring.throughput %}
      - job_name: throughput-probes
        kubernetes_sd_configs:
        - namespaces:
            names: {{ target_namespaces | tojson }}
          role: pod
        metrics_path: /metrics
        relabel_configs:
        - action: keep
          regex: '{{ monitoring.namespace }}'
          source_labels:
          - __meta_kubernetes_pod_annotation_monitoring_blueprint_throughput_owner
        - regex: (.+);([0-9]+)
          replacement: $1:$2
          source_labels:
          - __meta_kubernetes_pod_ip
          - __meta_kubernetes_pod_annotation_monitoring_blueprint_throughput_port
          target_label: __address__
        - source_labels:
          - __meta_kubernetes_namespace
          target_label: namespace
        - source_labels:
          - __meta_kubernetes_pod_name
          target_label: pod
        scrape_interval: '{{ monitoring.prometheus_scrape_interval }}'
{% endif %}
      - job_name: kubernetes-annotated-pods
        kubernetes_sd_configs:
        - namespaces:
            names: {{ target_namespaces | tojson }}
          role: pod
        relabel_configs:
        - action: keep
          regex: 'true'
          source_labels:
          - __meta_kubernetes_pod_annotation_prometheus_io_scrape
        - action: replace
          regex: (.+)
          source_labels:
          - __meta_kubernetes_pod_annotation_prometheus_io_path
          target_label: __metrics_path__
        - action: replace
          regex: ([^:]+)(?::\d+)?;(\d+)
          replacement: $1:$2
          source_labels:
          - __address__
          - __meta_kubernetes_pod_annotation_prometheus_io_port
          target_label: __address__
        - action: labelmap
          regex: __meta_kubernetes_pod_label_(.+)
        - action: replace
          source_labels:
          - __meta_kubernetes_namespace
          target_label: namespace
        - action: replace
          source_labels:
          - __meta_kubernetes_pod_name
          target_label: pod
        scrape_interval: '{{ monitoring.prometheus_scrape_interval }}'
{% if monitoring.observability.node_metrics %}
nodeExporter:
  enabled: true
prometheus-node-exporter:
  extraArgs: [--no-collector.cpufreq]
  tolerations:
    - operator: Exists
      effect: NoSchedule
{% endif %}
