{# OCUDU components: the upstream values, unchanged (the CSI logger environment comes from extra_env_vars), with #}
{# the O-RAN 7.2 fronthaul resources of a gNB or DU on a Benetel RU and the metrics exporter, read by the nador #}
{# ocudu-gnb and ocudu-du charts. #}
{% include 'ran/ocudu/ocudu-' ~ component.type ~ '/values.yaml.j2' %}

# O-RAN 7.2 fronthaul (radio fhi72): SR-IOV VFs of the node, in IFRAN order (U-plane VF, then C-plane VF), and 1G
# hugepages of the Guaranteed pod
{% if component.derived_radio_config is mapping and component.derived_radio_config.fhi72 is defined %}
fhi72:
  sriovResources:
{% for resource in component.derived_radio_config.fhi72.sriov_resources %}
    - {{ resource }}
{% endfor %}
  pciDeviceEnvVars:
{% for env_var in component.derived_radio_config.fhi72.pci_device_env_vars %}
    - {{ env_var }}
{% endfor %}
  hugepages1Gi: {{ component.resources.limits.nf.hugepages_1gi }}
{% else %}
fhi72: null
{% endif %}

# Prometheus exporter of the OCUDU JSON metrics (sidecar of the nador ocudu-gnb and ocudu-du charts): enabled with the
# remote control server (advanced_config.remote_control.enabled) and the JSON metrics (advanced_config.metrics.enable_json)
{% set advanced = component.advanced_config if component.advanced_config is mapping else {} %}
{% set remote_control = advanced.get('remote_control') or {} %}
metricsExporter:
{% if remote_control.get('enabled') and (advanced.get('metrics') or {}).get('enable_json') %}
  enabled: true
  image: ghcr.io/ziyad-mabrouk/telegraf:v1.0
  port: {{ remote_control.get('port', 8001) }}
{% else %}
  enabled: false
{% endif %}
