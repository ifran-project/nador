{# The upstream OAI configuration, unchanged unless CSI logging is on (CSI_LOGGING_ENABLED=1, set by configure_csi). #}
{# The CSI logger needs periodic SRS (and CSI-RS), which the upstream template does not expose: the two lines are #}
{# inserted as text after the single gNBs[0] min_rxtxtime line (a YAML round trip would rewrite values such as #}
{# mcc 001 or gNB_ID 0x1). An unexpected configuration fails the prepare step instead of logging no CSI. #}
{% set csi_env = component.extra_env_vars or {} %}
{% if csi_env.get('CSI_LOGGING_ENABLED') | string == '1' %}
{% set config %}{% include 'ran/oai/oai-' ~ component.type ~ '/config.yaml.j2' %}{% endset %}
{# Already set by the upstream template from advanced_config: kept when periodic. #}
{% if not (config is search('(?m)^    do_SRS: periodic$') and config is search('(?m)^    do_CSIRS: 1$')) %}
{% if config is search('(?m)^ +do_(SRS|CSIRS):') or config is not search('(?m)^    min_rxtxtime: ') %}
{# Undefined variable on purpose: fail the prepare step instead of rendering a config without SRS. #}
{{ csi_config_injection_failed_do_SRS_already_set_or_min_rxtxtime_not_found }}
{% endif %}
{% set config = config | regex_replace('^(    min_rxtxtime: [^\n]*)$', '\\1\n    do_SRS: periodic\n    do_CSIRS: 1', multiline=True) %}
{% endif %}
{{ config }}
{% else %}
{% include 'ran/oai/oai-' ~ component.type ~ '/config.yaml.j2' %}
{% endif %}
