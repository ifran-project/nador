{# Keep upstream values, adding only the statistics-parser configuration. #}
{% include 'ran/oai/oai-' ~ component.type ~ '/values.yaml.j2' %}

metricsParser:
  enabled: true
  # Published 2026.w38 image; parser source verified against the supplied branch.
  image: ghcr.io/ziyad-mabrouk/oai-gnb-metrics-parser@sha256:d8f793b51727f984f6a680016ff17d72612ce3018295dab1e2b82635af1f92f7
{# CSI logger (oai-csi-logging images): enabled by nador.csi.enable_csi through extra_env_vars. #}
{% set csi_env = component.extra_env_vars or {} %}
{% if csi_env.get('CSI_LOGGING_ENABLED') | string == '1' %}

csi:
  enabled: true
  # The logger writes <outputDir>/csi_per_rb.csv; outputDir is a hostPath on the gNB node.
  outputDir: {{ csi_env.get('CSI_OUTPUT_DIR', '/data/csi') }}
{% endif %}
